{
  "name": "@arraypress/llms-txt-astro",
  "version": "2.1.1",
  "description": "Deprecated: use @arraypress/seo-astro, whose seo() integration writes /llms.txt and whose @arraypress/seo-astro/llms has these route helpers. /llms.txt for Astro — a route helper plus the builder behind it.",
  "type": "module",
  "files": [
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./package.json": "./package.json",
    "./core": {
      "types": "./src/core.d.ts",
      "default": "./src/core.js"
    }
  },
  "keywords": [
    "astro",
    "llms-txt",
    "llmstxt",
    "ai",
    "llm",
    "agents",
    "discovery",
    "withastro"
  ],
  "author": "ArrayPress",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arraypress/llms-txt-astro.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "astro": "^6.0.0 || ^7.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "astro": "^7.0.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
